# Tracker Configuration
TRACKER_TYPE=keitaro  # keitaro, binom, or custom
TRACKER_URL=https://your-tracker.com
TRACKER_API_KEY=your-api-key-here

# For Custom tracker only
CUSTOM_HEADER_NAME=Authorization  # Header name for API key
CUSTOM_DOMAINS_PATH=domains  # JSON path to domains list (e.g. "data.domains")

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Check Configuration
CHECK_INTERVAL_MINUTES=15
CONSECUTIVE_FAILURES_THRESHOLD=2
SSL_WARNING_DAYS=7
MAX_CONCURRENT_CHECKS=10
REQUEST_TIMEOUT_SECONDS=10

# Database
DATABASE_PATH=data/domain_checker.db
